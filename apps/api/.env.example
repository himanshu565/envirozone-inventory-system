# Local disposable PostgreSQL used by docker-compose.yml.
DATABASE_URL=postgresql://envirozone:envirozone_dev@localhost:5433/envirostore

# Use the same random value in apps/web/.env.local.
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# COOKIE_DOMAIN=.example.com
# PORT=4000
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ALLOW_PRODUCTION_SEED=YES # Strictly required alongside ADMIN_EMAIL and ADMIN_PASSWORD if running seed in production

# Separate disposable local database URL required for integration tests (name must contain test/ci/tmp/temp)
# STOCK_TEST_DATABASE_URL=postgresql://envirozone:envirozone_dev@localhost:5433/envirostore_test

# Optional read-only knowledge assistant. Disabled by default.
AI_ENABLED=false
AI_ALLOW_RETRIEVAL_ONLY=false
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_CHAT_MODEL=
# AI_EMBEDDING_MODEL=
# AI_MAX_CONTEXT_CHUNKS=5
# AI_REQUEST_TIMEOUT_MS=10000
