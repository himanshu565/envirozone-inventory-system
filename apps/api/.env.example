# PostgreSQL connection string. For local dev via docker-compose.yml:
# postgresql://envirostore:envirostore@localhost:5433/envirostore
DATABASE_URL=

# Signing secret for session JWTs. MUST be the exact same value as
# apps/web/.env's JWT_SECRET, or the web app won't be able to verify
# tokens the API issues. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Origin the browser's requests will come from — required for CORS.
# Defaults to http://localhost:3000 if unset (dev only). Set this to
# your real web app URL in every deployed environment.
WEB_ORIGIN=http://localhost:3000

# Standard Node env flag. Must be "production" in production — it
# controls whether the session cookie is marked Secure (HTTPS-only).
NODE_ENV=development

# Only needed if apps/web and apps/api are deployed on different
# subdomains of the same parent domain (e.g. app.example.com and
# api.example.com) — set to the shared parent, e.g. ".example.com".
# Leave unset for same-host / same-domain deployments.
# COOKIE_DOMAIN=

# Port the API listens on. Defaults to 4000 if unset.
# PORT=4000

# Overrides for the one-time seed script (apps/api/src/prisma/seed.ts),
# which creates the first admin account. If unset, it falls back to
# admin@envirozone.local / ChangeMe123! — change these in any real
# deployment before running `npm run seed`.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
