# Signing secret for session JWTs. MUST be the exact same value as
# apps/api/.env's JWT_SECRET — this is how the web app verifies
# session tokens the API issued. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Base URL the browser uses to call the API directly (this is a
# NEXT_PUBLIC_ var, so it's bundled into client-side JS and visible
# to anyone — never put a secret in a NEXT_PUBLIC_ variable).
NEXT_PUBLIC_API_URL=http://localhost:4000
